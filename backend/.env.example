# Copy to `.env` and adjust for local development.

# Port the backend listens on.
PORT=8080

# SQLite database file.
DATABASE_URL=sqlite://./data/imwatching.db?mode=rwc

# HS256 signing key for JWT access tokens. REQUIRED — >= 32 chars.
JWT_SECRET=imwatching-default-jwt-secret-key-at-least-32-chars-long

# Directory where uploaded videos + extracted frames are stored.
MEDIA_DIR=./media

# Max bytes accepted for a single uploaded video. Default 200 MiB.
MAX_UPLOAD_BYTES=209715200

# Comma-separated emails that become ADMIN on first registration.
ADMIN_EMAILS=

# --- AI VISION (analyzes frames — REQUIRES a multimodal model) ---
# OpenAI-compatible endpoint. Works with OpenAI, Gemini-compatible gateways,
# Ollama, vLLM, LM Studio, etc.
# The model MUST accept image input (e.g. gemini-3.8-flash, gpt-4o, llava).
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECS=60

# --- AI CHAT (chatbot — text only, any cheap model works) ---
# Left empty = falls back to the vision config above.
# Point this at a CHEAP text model to save money; the chatbot only ever
# sends JSON text, never images.
CHAT_ENABLED=true
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=

# --- CommandCode (paid OpenAI-compatible aggregator) ---
# Powers the cheap preset models selectable in the UI: MiMo, Qwen, DeepSeek,
# MiniMax, Ling... Fill these to unlock those presets.
COMMANDCODE_BASE_URL=
COMMANDCODE_API_KEY=

# --- FFmpeg ---
# Binary names/paths. Defaults assume ffmpeg/ffprobe are on PATH.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Frame extraction cadence (frames per second). Default 1 fps.
FRAME_FPS=1

# Optional
RUST_LOG=info,sqlx=warn,tower_http=info
